# ======== Gemma 4 26B-A4B (MoE, ~4B active) — benchmark model ========
# Source: unsloth/gemma-4-26B-A4B-it-GGUF — gemma-4-26B-A4B-it-UD-Q8_K_XL.gguf (27.6 GB)
# Point FROM at your local copy of that file.
#
# Gemma 4 GGUFs from HF ship with a BROKEN chat template (wrong turn
# delimiters -> model outputs "---" on repeat). Fix: the TEMPLATE stub
# plus RENDERER/PARSER lines force Ollama's built-in Gemma 4 formatting.
# Requires Ollama 0.20.2+.
# Sampling params are Google's recommended Gemma settings.

FROM ./gemma-4-26B-A4B-it-UD-Q8_K_XL.gguf
TEMPLATE {{ .Prompt }}
RENDERER gemma4
PARSER gemma4
PARAMETER top_k 64
PARAMETER top_p 0.95
PARAMETER temperature 1
PARAMETER num_ctx 131072
